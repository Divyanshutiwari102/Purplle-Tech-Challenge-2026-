# Slim image for the FastAPI service. Detection deps live in
# Dockerfile.pipeline so the API container stays small (~120 MB).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STORE_INTEL_DB=/data/store_intel.db

WORKDIR /app

COPY requirements-api.txt /tmp/req.txt
RUN pip install --no-cache-dir -r /tmp/req.txt

COPY app /app/app

RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=4 --start-period=10s \
    CMD python -c "import urllib.request,sys;\
import json;\
r=urllib.request.urlopen('http://localhost:8000/health',timeout=3);\
sys.exit(0 if r.status==200 else 1)" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
