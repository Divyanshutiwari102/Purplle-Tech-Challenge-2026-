# Frontend env vars.
#
# In Vercel: set VITE_API_URL to the Railway backend URL.
# Locally with `npm run dev` or in docker-compose, leave this empty
# and the app falls back to `/api`, which the Vite dev server / nginx
# proxies to http://localhost:8000.
VITE_API_URL=https://your-railway-url.up.railway.app
