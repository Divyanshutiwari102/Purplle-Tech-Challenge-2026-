FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-dashboard.txt /tmp/req.txt
RUN pip install --no-cache-dir -r /tmp/req.txt

COPY dashboard /app/dashboard

EXPOSE 8501

HEALTHCHECK --interval=15s --timeout=5s --retries=4 --start-period=15s \
    CMD python -c "import urllib.request,sys; r=urllib.request.urlopen('http://localhost:8501/_stcore/health',timeout=3); sys.exit(0 if r.status==200 else 1)" || exit 1

CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
